{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hwc.ma/schemas/marketing-final-strategy.schema.json",
  "title": "MarketingStrategyResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "companySummary", "currentAudit", "smartObjective", "targetAudience", "positioning", "priorityChannels", "fourWeekPlan", "budgetAndResources", "kpis", "assumptions", "immediatePriority"],
  "properties": {
    "sessionId": { "type": "string", "minLength": 1 },
    "companySummary": { "type": "string", "minLength": 1 },
    "currentAudit": { "type": "string", "minLength": 1 },
    "smartObjective": { "type": "string", "minLength": 1 },
    "targetAudience": { "type": "object", "additionalProperties": true },
    "positioning": { "type": "object", "additionalProperties": true },
    "priorityChannels": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "object", "required": ["name", "justification", "objective", "requiredResources"], "additionalProperties": true } },
    "fourWeekPlan": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "object", "required": ["week", "actions"], "additionalProperties": true } },
    "budgetAndResources": { "type": "object", "additionalProperties": true },
    "kpis": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": true } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "pointsToVerify": { "type": "array", "items": { "type": "string" } },
    "immediatePriority": { "type": "string", "minLength": 1 }
  }
}
